{
  "name": "ksfraser/fa-product-attributes",
  "version": "1.0.2",
  "description": "FrontAccounting-compatible ordered product attributes (royal order of adjectives)",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "KS Fraser"
    }
  ],
  "require": {
    "php": ">=7.3",
    "ksfraser/fa-hooks": "^1.0 || dev-main",
    "ksfraser/ksf-modules-dao": "^0.3",
    "ksfraser/ksf-schemamanager": "*",
    "ksfraser/ksf-fa-common": "*",
    "ksfraser/fa-product-attributes-core": "*",
    "ksfraser/traits": "^1.4 || dev-main"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5.0",
    "nikic/php-parser": "^4.0",
    "ksfraser/famock": "^0.10"
  },
  "autoload": {
    "psr-4": {
      "Ksfraser\\FA_ProductAttributes\\": "src/Ksfraser/FA_ProductAttributes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ksfraser\\FA_ProductAttributes\\Test\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "7.3.21"
    }
  }
}
